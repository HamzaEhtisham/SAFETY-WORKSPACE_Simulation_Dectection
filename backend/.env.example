# Optional live reputation checks. Keep real keys only in .env (never commit them).
ENABLE_REPUTATION_CHECKS=true
GOOGLE_SAFE_BROWSING_API_KEY=replace_with_your_google_api_key
VIRUSTOTAL_API_KEY=replace_with_your_virustotal_api_key

# Optional local LLM review for live-reputation/ML disagreements.
OLLAMA_REVIEW_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT_SECONDS=90
